# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (server only)
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash)
GEMINI_MODEL=

# Selar payment links (checkout pages)
NEXT_PUBLIC_SELAR_STARTER_URL=https://selar.com/47plan?currency=USD
NEXT_PUBLIC_SELAR_PROFESSIONAL_URL=https://selar.com/57plan?currency=USD
NEXT_PUBLIC_SELAR_PRACTICE_URL=https://selar.com/97plan?currency=USD
# Shared secret used to verify payment confirmations (webhook or admin action)
PAYMENT_WEBHOOK_SECRET=

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
